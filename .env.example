# Salin ke .env.local dan isi nilainya. JANGAN commit .env.local.

# Supabase (Project Settings -> API Keys / Data API)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=            # server only, jangan beri prefix NEXT_PUBLIC_

# Hash IP di click_events: string acak panjang (openssl rand -hex 32)
IP_HASH_SALT=

# URL publik situs (untuk canonical, sitemap, Open Graph). Contoh: https://fauqa.id
NEXT_PUBLIC_SITE_URL=

# Analytics (opsional; kosong = script tidak dimuat)
NEXT_PUBLIC_GA_ID=                     # G-XXXXXXXXXX
NEXT_PUBLIC_CLARITY_ID=

# Admin login
ADMIN_PASSWORD=                        # password kuat
ADMIN_SESSION_SECRET=                  # openssl rand -hex 32; ganti untuk logout semua session
